# =============================================================================
# VFB Workshop Site — Multi-stage Docker build
# 
# Stage 1: Build Hugo site
# Stage 2: Serve with Nginx
# =============================================================================

# --- Stage 1: Build ----------------------------------------------------------
FROM hugomods/hugo:0.122.0 AS builder

WORKDIR /src
COPY site/ .

# Build the site
RUN hugo --minify --gc --verbose

# --- Stage 2: Serve ----------------------------------------------------------
FROM nginx:alpine

LABEL maintainer="Virtual Fly Brain <support@virtualflybrain.org>"
LABEL description="VFB NeuroFly 2026 Workshop Site"
LABEL org.opencontainers.image.source="https://github.com/VirtualFlyBrain/neurofly2026-workshop"

# Copy built site from builder
COPY --from=builder /src/public /usr/share/nginx/html

# Copy nginx configuration
COPY <<'EOF' /etc/nginx/conf.d/default.conf
server {
    listen 80;
    server_name workshop.virtualflybrain.org;
    root /usr/share/nginx/html;
    index index.html;
    
    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml application/xml+rss text/javascript application/rss+xml;
    
    # Cache static assets aggressively
    location ~* \.(css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }
    
    # Cache HTML lightly
    location ~* \.html$ {
        expires 1h;
        add_header Cache-Control "public, must-revalidate";
    }
    
    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    
    # Error pages
    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
}
EOF

# Expose HTTP
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

# Run nginx
CMD ["nginx", "-g", "daemon off;"]
